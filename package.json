{
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "name": "grafana-flamegraph-solo",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "description": "Grafana flamegraph visualization component",
  "keywords": [
    "grafana",
    "flamegraph",
    "profiling",
    "pyroscope"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/simonswine/grafana-flamegraph-solo-x.git"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./style.css": "./dist/esm/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json && rollup -c rollup.config.ts --configPlugin esbuild",
    "bundle": "rollup -c rollup.config.ts --configPlugin esbuild",
    "clean": "node -e \"const fs = require('node:fs'); for (const p of ['dist', 'compiled', 'package.tgz']) fs.rmSync(p, { recursive: true, force: true })\"",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit",
    "prepack": "pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check ."
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "react": "^19.2.8",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rsbuild/core": "^2.1.9",
    "@rsbuild/plugin-react": "^2.1.0",
    "@storybook/react": "10.3.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/tinycolor2": "1.4.6",
    "esbuild": "0.28.1",
    "jsdom": "^30.1.1",
    "react-dom": "^19.2.8",
    "rollup": "^4.60.1",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "10.3.6",
    "storybook-react-rsbuild": "3.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
